# ============================================================================
# Rain Drop Volume Prediction Using AI
# Environment Configuration & Database Credentials Template
#
# IMPORTANT:
# - Copy this file to .env and set your actual local secrets.
# - Do NOT commit .env to source control (.env is excluded by .gitignore).
# ============================================================================

# Database Connection (PostgreSQL / TimescaleDB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=raindrop_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SSLMODE=prefer

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Backend & Application Settings
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
